# Number of days of transactions to request from SimpleFIN.
# Keep routine refreshes comfortably below SimpleFIN's recommended window.
SIMPLEFIN_DAYS=30

# Include pending transactions when the provider supports them.
SIMPLEFIN_PENDING=true

# Optional 32-byte key encoded as base64 or hex.
# If omitted, the POC creates data/simplefin-key automatically.
SIMPLEFIN_ENCRYPTION_KEY=

# Local server port.
PORT=8000
